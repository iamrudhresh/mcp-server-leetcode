{
    "name": "@iamrudhresh/mcp-server-leetcode",
    "description": "MCP Server for LeetCode API (supports leetcode.com and leetcode.cn)",
    "version": "1.5.1",
    "author": "iamrudhresh",
    "main": "./build/index.js",
    "keywords": [
        "leetcode",
        "lc",
        "mcp",
        "programming",
        "algorithm"
    ],
    "scripts": {
        "test": "vitest run | pino-pretty",
        "test:watch": "vitest watch",
        "build": "tsc && node -e \"try{fs.chmodSync('build/index.js',0o755)}catch{}\"",
        "start": "node build/index.js",
        "dev": "tsc-watch --onSuccess \"node build/index.js\"",
        "format": "prettier --write .",
        "prepare": "husky",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix"
    },
    "bin": {
        "mcp-server-leetcode": "build/index.js",
        "leetcode-mcp-server": "build/index.js"
    },
    "type": "module",
    "files": [
        "build"
    ],
    "license": "MIT",
    "homepage": "https://iamrudhresh.github.io/mcp-server-leetcode/",
    "bugs": {
        "url": "https://github.com/iamrudhresh/mcp-server-leetcode/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/iamrudhresh/mcp-server-leetcode.git"
    },
    "lint-staged": {
        "*.{js,ts,jsx,tsx}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.{md,json,yml,yaml,html,css}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.2",
        "leetcode-query": "^2.0.1",
        "minimist": "^1.2.8",
        "pino": "^10.4.0",
        "ts-node": "^10.9.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/minimist": "^1.2.5",
        "@types/node": "^26.6.10",
        "esbuild": "^0.28.2",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.2",
        "prettier": "^3.10.1",
        "prettier-plugin-organize-imports": "^4.3.0",
        "tsc-watch": "7.2.1",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.74.0",
        "vitest": "^5.1.2",
        "vite": "^8.3.8",
        "pino-pretty": "^13.2.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "^4.68.8"
    }
}
